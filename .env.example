# true = demo local con login ficticio. Nunca usar datos reales ni desplegarla.
NEXT_PUBLIC_DEMO_MODE=false

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Utiliza únicamente la clave pública anon/publishable. Nunca service_role.
# Antes de activar el modo real: migraciones 0001–0020, usuario autorizado y MFA.
# npm run check:database comprueba el esquema sin escribir datos.

# Dirección pública de la web, para los enlaces de los correos de alta y de
# recuperación de contraseña (p. ej. https://fastpass.tudominio.es). Debe estar
# también en Supabase → Authentication → URL Configuration.
# Obligatoria en producción: origen HTTPS, sin ruta, consulta ni credenciales.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
